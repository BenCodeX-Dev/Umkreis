# Copy to .env and fill in. Never commit .env.

# destination.one open data (no key; event databases of German tourism regions). On by default.
# Set to off to disable. Only public-domain/CC0 records are used.
# DESTINATION_ONE=off

# Ticketmaster Discovery API key (free): https://developer.ticketmaster.com/
# Without any source (open data off, no key, no iCal feeds) there is no data: the app shows how to add a source, nothing invented.
TICKETMASTER_API_KEY=

# Path to a JSON list of public iCal/ICS feeds (markets, community, city calendars).
# See config/feeds.example.json. Default: config/feeds.json
ICS_FEEDS_FILE=config/feeds.json

# Place search (OpenStreetMap Nominatim, max 1 request/s, no autocomplete).
# The User-Agent must identify your deployment, ideally with a contact URL or e-mail.
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=Umkreis/0.1 (self-hosted local events app)

# Production server (npm start)
PORT=8787
HOST=127.0.0.1
# Host names (with port) the server answers to; others get 421. Protects against DNS rebinding.
# Not needed on 127.0.0.1/localhost (then the loopback names are used). Required when HOST is
# 0.0.0.0 or a public address, e.g. ALLOWED_HOSTS=events.example.org
# ALLOWED_HOSTS=
# Behind your own reverse proxy only: count rate limits per client by the last X-Forwarded-For entry.
# Leave unset when the server is reachable directly – clients could then choose their own key.
# TRUST_PROXY=1

# In-app map tiles. Default: OpenStreetMap's public tiles, fine for personal use; their usage policy
# rules out heavy traffic. A busy public site sets its own or a commercial tile service (https only,
# with {z}, {x} and {y}); its host is added to the Content-Security-Policy automatically.
# MAP_TILE_URL=https://tiles.example.org/{z}/{x}/{y}.png
# Credit text the tile service requires (plain text, shown on the map).
# MAP_TILE_ATTRIBUTION=© OpenStreetMap-Mitwirkende, Kacheln: Example Tiles

# Impressum and privacy policy (plain text, shown as links in the footer). Templates:
# config/impressum.example.txt, config/datenschutz.example.txt. Defaults below; missing files are fine
# locally, a publicly reachable server warns at start when the Impressum is missing.
# IMPRESSUM_FILE=config/impressum.txt
# PRIVACY_FILE=config/datenschutz.txt
