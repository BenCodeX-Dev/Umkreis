# Copy to .env and fill in. Never commit .env.

# Ticketmaster Discovery API key (free): https://developer.ticketmaster.com/
# Without it (and without iCal feeds) the app runs in clearly labelled demo mode.
TICKETMASTER_API_KEY=

# Path to a JSON list of public iCal/ICS feeds (markets, community, city calendars).
# See config/feeds.example.json. Default: config/feeds.json
ICS_FEEDS_FILE=config/feeds.json

# Demo mode: auto (only when no real source is configured) | on | off
DEMO_MODE=auto

# Place search (OpenStreetMap Nominatim, max 1 request/s, no autocomplete).
# The User-Agent must identify your deployment, ideally with a contact URL or e-mail.
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=Umkreis/0.1 (self-hosted local events app)

# Production server (npm start)
PORT=8787
HOST=127.0.0.1
